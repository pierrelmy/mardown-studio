{
  "name": "markdown-studio",
  "version": "0.1.0",
  "description": "Un éditeur Markdown local, rapide et soigné",
  "author": {
    "name": "Pierre Lamey",
    "url": "https://github.com/pierrelmy"
  },
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "start": "install-electron && electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:desktop": "install-electron && npm run build && node tests/desktop.mjs",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "test:coverage": "vitest run --coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "release:plan": "node scripts/prepare-release.mjs",
    "dist:release": "npm run build && electron-builder --config electron-builder.release.cjs --publish never",
    "test:installer": "node tests/installer-desktop.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "studio.markdown.app",
    "productName": "Markdown Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Markdown Studio <145355285+pierrelmy@users.noreply.github.com>"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pierrelmy",
        "repo": "mardown-studio"
      }
    ],
    "extraResources": [
      {
        "from": "electron/update-helper.cjs",
        "to": "update-helper.cjs"
      }
    ]
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.65.0",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/pierrelmy/mardown-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/pierrelmy/mardown-studio.git"
  }
}
